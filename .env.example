# ---------------------------------------------------------------------------
# APEX: Zero Latency — environment
# Copy to .env.local. Every value here is safe to expose to the browser.
# ---------------------------------------------------------------------------

# Solana base layer (settlement). devnet | testnet | mainnet-beta | custom
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# MagicBlock Ephemeral Rollup endpoint. Probed working 2026-07-29.
# Regional alternative: https://devnet-as.magicblock.app
NEXT_PUBLIC_ER_RPC=https://devnet.magicblock.app
NEXT_PUBLIC_ER_WS=wss://devnet.magicblock.app

# Optional: MagicBlock magic-router. Requires an access key — returns 403 without one.
# When set, transactions are auto-routed between base layer and ER by the router.
# NEXT_PUBLIC_MAGIC_ROUTER_RPC=https://devnet-router.magicblock.app

# apex_racing program id. Must match programs/apex_racing/src/lib.rs declare_id!.
# While unset or undeployed the game runs in Simulation mode (XP is local only).
NEXT_PUBLIC_APEX_PROGRAM_ID=ApeXRacing11111111111111111111111111111111

# How often the ER auto-commits delegated state back to the base layer, in ms.
NEXT_PUBLIC_ER_COMMIT_FREQUENCY_MS=30000
